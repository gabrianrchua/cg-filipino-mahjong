# The production service binds one HTTP and WebSocket listener.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Leave unset for the normal same-origin production deployment. For split-origin
# development only, use one origin or a comma-separated allowlist.
# CORS_ORIGIN=http://localhost:5173

# Optional delay before bot decisions, in milliseconds.
# BOT_DECISION_DELAY_MS=600
