{
  "name": "cg-filipino-mahjong",
  "version": "1.0.0",
  "description": "Filipino-style online mahjong with friends",
  "license": "MIT",
  "author": "CGIXE",
  "private": true,
  "type": "esm",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.1"
  }
}
